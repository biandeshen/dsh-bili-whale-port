{
  "name": "dsh-bili-whale",
  "version": "0.5.2",
  "description": "养一条有日子的鱼：让 DSH 里的 agent 自己刷 B 站、看懂视频、写两本日记，把值得的 @ 你。设置里有「养鱼」完整设置页（27 项）+ 依赖体检 + cookie 写入 + 共享配置（与工具链同一份 bili-whale.config.json）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "agent",
    "diary"
  ],
  "type": "module",
  "scripts": {
    "test": "node scripts/run-mjs-tests.mjs",
    "gates": "node scripts/check-mjs-syntax.mjs && node scripts/run-mjs-tests.mjs --report docs/evidence/ && node scripts/run-mjs-tests.mjs --root ../Cortico-up --import tsx --report docs/evidence/ && node scripts/check-consumers.mjs && node scripts/check-hashes.mjs && node scripts/check-state-roots.mjs && node scripts/check-live-drift.mjs",
    "mjs-syntax": "node scripts/check-mjs-syntax.mjs",
    "drift": "node scripts/check-live-drift.mjs",
    "hashes": "node scripts/check-hashes.mjs",
    "hashes:write": "node scripts/check-hashes.mjs --write",
    "day:seed": "node scripts/day-snapshot.mjs --seed",
    "day:tick": "node scripts/day-snapshot.mjs --tick",
    "day:report": "node scripts/day-report.mjs",
    "g3b": "node scripts/g3b-check.mjs",
    "observe": "node scripts/observation-status.mjs",
    "observe:day": "node scripts/observation-day.mjs",
    "ops:day": "node scripts/ops-day.mjs",
    "ops:backup": "node scripts/ops-backup.mjs",
    "ops:repair-mem": "node scripts/repair-memory-source.mjs",
    "ops:repair-mem:go": "node scripts/repair-memory-source.mjs --go",
    "observe:start": "node scripts/observation-start.mjs",
    "audit:goal": "node scripts/goal-audit.mjs",
    "c2:arm": "node scripts/c2-offline.mjs arm",
    "c2:verify": "node scripts/c2-offline.mjs verify",
    "c2:check": "node scripts/c2-window.mjs check",
    "watchdog": "node scripts/day-watchdog.mjs --audit",
    "wake:audit": "node scripts/wake-audit.mjs",
    "action:watch": "node scripts/action-watch.mjs"
  },
  "main": "core/index.js",
  "exports": {
    ".": "./core/index.js",
    "./client": "./core/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "core",
    "adapters",
    "panel",
    "docs",
    "scripts",
    "tools",
    "cordis.patch.yml",
    "README.md",
    "tests",
    "AUDIT-FIXES.md",
    "RISK-PROTECTION.md",
    "AI-SHARE-TRIAL.md",
    "LOCAL-UPDATE.md",
    "ISSUE27-FIX.md",
    "LISTENER-FIX.md",
    "DM-HISTORY-FIX.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT"
}
