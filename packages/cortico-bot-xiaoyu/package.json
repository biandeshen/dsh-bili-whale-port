{
  "name": "cortico-bot-xiaoyu",
  "version": "0.1.b39c7763",
  "type": "module",
  "description": "小鱼的对内能力一拖三薄转接头（挂载 cap-state-rhythm / cap-memory / cap-journal，对接 Cortico bot api:7 或任意宿主）。",
  "keywords": [
    "cortico-bot",
    "cortico"
  ],
  "main": "./src/cortico-definition.ts",
  "exports": {
    ".": "./src/cortico-definition.ts",
    "./hub": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "cortico": {
    "kind": "bot",
    "api": 7,
    "tags": [
      "companion",
      "bilibili"
    ],
    "describe": "describe.json",
    "webUiClient": "dist/webui.js"
  },
  "files": [
    "README.md",
    "describe.json",
    "dist",
    "src"
  ],
  "dependencies": {
    "@xiaoyu/persona-core": "workspace:*",
    "@xiaoyu/cap-state-rhythm": "workspace:*",
    "@xiaoyu/cap-memory": "workspace:*",
    "@xiaoyu/cap-journal": "workspace:*"
  }
}
